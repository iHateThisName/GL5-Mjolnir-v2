      m_Calls: []
  m_text: "Tutorial Scenario: You walk out of the elevator and get hit in the head by a falling ceiling lamp. You wake up seeing a coworker concerned about your well being. The coworker will check if you're well enough to work, by asking you to look around(moving the mouse) and walk to your desk(using WASD keys). They will also check if your memory is ok by having you use your computer and phone (Point and click the left mouse button to interact with the chair, computer and the phone). When the coworker sees you do it all, they declare you\u2019re good enough to continue your work.\n\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
